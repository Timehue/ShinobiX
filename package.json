{
    "name": "shinobix-api",
    "version": "1.0.0",
    "private": true,
    "description": "ShinobiX game API — Express backend on Railway, Supabase storage",
    "engines": {
        "node": ">=22"
    },
    "scripts": {
        "build:server": "tsc -p tsconfig.cpanel.json",
        "build:client": "npm run check:story-content && node scripts/build-client.mjs",
        "build": "npm run build:server && npm run build:client && npm run verify:dist && npm run sizecheck",
        "verify:dist": "node scripts/verify-dist.mjs",
        "start": "node app.js",
        "dev": "node --watch app.js",
        "slice-badges": "node scripts/slice-badges.mjs",
        "pretest": "npm ci --prefix shinobij.client",
        "test": "node --import tsx scripts/run-tests.mjs",
        "test:ci": "node --import tsx scripts/run-tests.mjs",
        "test:hollow-gate-soak": "node --import tsx --test api/hollow-gate/_reconnect-soak.test.ts",
        "test:mission-eligibility": "node scripts/check-mission-eligibility.mjs",
        "test:release-assets": "node scripts/check-release-assets.mjs",
        "test:pet-breeding-odds": "node --import tsx scripts/pet-breeding-odds-audit.mjs",
        "sizecheck": "node scripts/check-build-size.mjs",
        "generate:story-content": "node --import tsx scripts/generate-story-content.mts",
        "check:story-content": "node --import tsx scripts/generate-story-content.mts --check",
        "generate:runtime-mode-docs": "node --import tsx scripts/generate-runtime-mode-docs.mjs",
        "check:runtime-mode-docs": "node --import tsx scripts/generate-runtime-mode-docs.mjs --check",
        "release:health": "node scripts/release-health-check.mjs",
        "beta:report": "node scripts/beta-daily-report.mjs",
        "beta:certify": "node scripts/beta-certification.mjs",
        "check:deployment": "node scripts/check-deployment-config.mjs",
        "check:rollback-readiness": "node scripts/rollback-readiness.mjs",
        "backup:kv": "node scripts/kv-backup.mjs export",
        "restore:kv": "node scripts/kv-backup.mjs restore",
        "drill:restore": "node scripts/kv-backup.mjs drill",
        "test:backup": "node --test scripts/kv-backup.test.mjs",
        "certify:release": "node scripts/release-certification.mjs",
        "soak": "node scripts/load-soak.mjs",
        "soak:smoke": "node scripts/load-soak.mjs --players=24 --seconds=8 --ramp=2",
        "certify:clan-boss-operation": "node --import tsx scripts/clan-boss-operation-certification.ts",
        "audit:clan-boss-balance": "node --import tsx scripts/clan-boss-balance-sim.ts",
        "audit:pvp-balance": "node --import tsx scripts/pvp-level-balance-sim.ts",
        "audit:pvp-competitive": "node --import tsx scripts/pvp-level-balance-sim.ts --competitive-only",
        "scan:data": "node --import tsx scripts/data-integrity-scan.mjs",
        "ledger:audit": "node --import tsx scripts/currency-ledger-audit.mjs",
        "ledger:backfill": "node --import tsx scripts/currency-ledger-audit.mjs --backfill",
        "export:tooling-handoffs": "node --import tsx scripts/export-tooling-handoffs.mjs",
        "check:tooling-handoffs": "node --import tsx scripts/export-tooling-handoffs.mjs --check"
    },
    "dependencies": {
        "@sentry/node": "^10.71.0",
        "@supabase/supabase-js": "^2.112.4",
        "compression": "^1.8.1",
        "dotenv": "^17.0.0",
        "express": "^5.0.1",
        "pg": "^8.23.0",
        "socket.io": "^4.8.3",
        "undici": "^8.10.0"
    },
    "devDependencies": {
        "@types/compression": "^1.8.1",
        "@types/express": "^5.0.0",
        "@types/node": "^26.4.0",
        "@types/pg": "^8.23.1",
        "sharp": "^0.35.3",
        "tsx": "^4.23.12",
        "typescript": "^5.7.0"
    }
}
