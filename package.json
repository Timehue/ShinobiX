{
    "name": "shinobix-api",
    "version": "1.0.0",
    "private": true,
    "description": "ShinobiX game API — Express backend on Railway, Supabase storage",
    "engines": {
        "node": ">=22"
    },
    "scripts": {
        "build:server": "tsc -p tsconfig.cpanel.json",
        "build:client": "cd shinobij.client && npm ci && npm run build",
        "build": "npm run build:server && npm run build:client && npm run verify:dist && npm run sizecheck",
        "verify:dist": "node scripts/verify-dist.mjs",
        "start": "node app.js",
        "dev": "node --watch app.js",
        "slice-badges": "node scripts/slice-badges.mjs",
        "test": "node --import tsx scripts/run-tests.mjs",
        "test:hollow-gate-soak": "node --import tsx --test api/hollow-gate/_reconnect-soak.test.ts",
        "test:mission-eligibility": "node scripts/check-mission-eligibility.mjs",
        "test:release-assets": "node scripts/check-release-assets.mjs",
        "sizecheck": "node scripts/check-build-size.mjs",
        "release:health": "node scripts/release-health-check.mjs",
        "beta:report": "node scripts/beta-daily-report.mjs",
        "beta:certify": "node scripts/beta-certification.mjs",
        "check:deployment": "node scripts/check-deployment-config.mjs",
        "check:rollback-readiness": "node scripts/rollback-readiness.mjs",
        "backup:kv": "node scripts/kv-backup.mjs export",
        "restore:kv": "node scripts/kv-backup.mjs restore",
        "drill:restore": "node scripts/kv-backup.mjs drill",
        "test:backup": "node --test scripts/kv-backup.test.mjs",
        "certify:release": "node scripts/release-certification.mjs",
        "soak": "node scripts/load-soak.mjs",
        "ledger:audit": "node --import tsx scripts/currency-ledger-audit.mjs",
        "ledger:backfill": "node --import tsx scripts/currency-ledger-audit.mjs --backfill"
    },
    "dependencies": {
        "@sentry/node": "^10.58.0",
        "@supabase/supabase-js": "^2.106.1",
        "compression": "^1.8.1",
        "dotenv": "^17.0.0",
        "express": "^5.0.1",
        "pg": "^8.21.0",
        "socket.io": "^4.8.3",
        "undici": "^6.26.0"
    },
    "devDependencies": {
        "@types/compression": "^1.8.1",
        "@types/express": "^5.0.0",
        "@types/node": "^22.0.0",
        "@types/pg": "^8.11.0",
        "sharp": "^0.35.3",
        "tsx": "^4.22.3",
        "typescript": "^5.7.0"
    }
}
