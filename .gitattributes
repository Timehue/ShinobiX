###############################################################################
# Set default behavior to automatically normalize line endings.
###############################################################################
* text=auto

# Generated tooling handoffs are compared byte-for-byte by the freshness gate.
# Keep them LF on Windows as well as CI so checkout alone cannot make them stale.
docs/generated/*.json text eol=lf
docs/generated/*.csv text eol=lf
# Pet review receipts fingerprint these JSON evidence files byte-for-byte.
docs/screenshots/**/*.json text eol=lf
