# Dependencies — reinstalled inside the image
node_modules
shinobij.client/node_modules

# Build output — rebuilt inside the image (avoid shipping stale committed dist/)
dist
shinobij.client/dist

# Secrets — never bake into the image; set env vars in the platform dashboard
.env
shinobij.client/.env

# VCS / tooling / editor
.git
.gitignore
.vs
.claude
.vercel

# Release builds need application source and runtime assets, not the 68 MB of
# review evidence or browser-test fixtures. Keeping these out of Railway's
# Docker context shortens the build's critical path without changing dist/.
.github
docs
release-audit
**/*.test.*
**/*.spec.*
shinobij.client/e2e*
shinobij.client/art-references
shinobij.client/playwright*.ts
shinobij.client/*preview.html

# Docker
Dockerfile
.dockerignore

# Logs and local artifacts
*.log
npm-debug.log*
*.pdf
*.zip
tmp
publish
deploy.zip
upstash-backup-*.json
Shinobi Journey/
# Ship only the reviewed Pet Coliseum runtime models. Generated QA renders,
# concepts, proofs, sources, and references remain excluded from Docker.
shinobij.client/public/pet-models/*
!shinobij.client/public/pet-models/roster/
!shinobij.client/public/pet-models/roster/*.glb
# Showdown four-pet camera models. Same rule as the roster: the directory has
# to be re-included before the GLBs inside it can be, and this MUST mirror
# .gitignore — a model committed but absent from the image 404s in production
# only, inside the r3f Suspense boundary, taking the whole screen down.
!shinobij.client/public/pet-models/showdown-v2/
!shinobij.client/public/pet-models/showdown-v2/*.glb
# Certified eight-rig LODs and software-only model-derived impostors.
!shinobij.client/public/pet-models/warfront-lod/
!shinobij.client/public/pet-models/warfront-lod/*.glb
!shinobij.client/public/pet-models/warfront-lod/manifest.json
!shinobij.client/public/pet-models/warfront-lod/roster/
!shinobij.client/public/pet-models/warfront-lod/roster/*.glb
!shinobij.client/public/pet-models/warfront-lod/showdown-v2/
!shinobij.client/public/pet-models/warfront-lod/showdown-v2/*.glb
!shinobij.client/public/pet-models/warfront-impostors/
!shinobij.client/public/pet-models/warfront-impostors/*.webp
!shinobij.client/public/pet-models/warfront-impostors/manifest.json
!shinobij.client/public/pet-models/warfront-impostors/roster/
!shinobij.client/public/pet-models/warfront-impostors/roster/*.webp
!shinobij.client/public/pet-models/warfront-impostors/showdown-v2/
!shinobij.client/public/pet-models/warfront-impostors/showdown-v2/*.webp
# Stage-0 starters. These are the model EVERY new player fights with until they
# evolve, so leaving them out 404s the Coliseum for exactly the accounts that
# have never seen it. Ship them alongside their -r/-l evolutions.
!shinobij.client/public/pet-models/starter-earth.glb
!shinobij.client/public/pet-models/starter-fire.glb
!shinobij.client/public/pet-models/starter-lightning.glb
!shinobij.client/public/pet-models/starter-water.glb
!shinobij.client/public/pet-models/starter-wind.glb
!shinobij.client/public/pet-models/starter-earth-l.glb
!shinobij.client/public/pet-models/starter-earth-r.glb
!shinobij.client/public/pet-models/starter-fire-l.glb
!shinobij.client/public/pet-models/starter-fire-r.glb
!shinobij.client/public/pet-models/starter-lightning-l.glb
!shinobij.client/public/pet-models/starter-lightning-r.glb
!shinobij.client/public/pet-models/starter-water-l.glb
!shinobij.client/public/pet-models/starter-water-r.glb
!shinobij.client/public/pet-models/starter-wind-l.glb
!shinobij.client/public/pet-models/starter-wind-r.glb
# Hollow Warfront runtime prop/boss GLBs — MUST ship in the Docker image or the
# 3D stage 404s them (SPA index.html) and crashes. Mirror of the .gitignore allow.
!shinobij.client/public/pet-models/gate-warden.glb
!shinobij.client/public/pet-models/gate-warden-rigged.glb
!shinobij.client/public/pet-models/ward-totem.glb
!shinobij.client/public/pet-models/wf-boulder.glb
!shinobij.client/public/pet-models/wf-lantern.glb
!shinobij.client/public/pet-models/roster-manifest.json
