<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Shown while the process starts, until Flutter draws its first frame.
         Dark, so launching never flashes white. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <!-- Behind the Flutter UI for the rest of the app's life. -->
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/shell_background</item>
    </style>
</resources>
