import { readFileSync, writeFileSync } from 'node:fs';
import { resolve } from 'node:path';
import { PET_CATALOG } from '../api/pet/_catalog.js';

const entries = Object.values(PET_CATALOG).map(p => [p.id, p.name, p.element, p.rarity, p.role ?? 'balanced']);
const output = `// Generated by scripts/generate-pet-tactics-catalog.mts from the canonical pet catalog.\nexport const PET_TACTICS_IDENTITIES: readonly (readonly string[])[] = ${JSON.stringify(entries, null, 2)};\n`;
const path = resolve(import.meta.dirname, '../shared/pet-tactics-catalog.ts');
if (process.argv.includes('--check')) {
    if (readFileSync(path, 'utf8').replaceAll('\r\n', '\n') !== output) throw new Error('Pet tactics catalog is stale. Run scripts/generate-pet-tactics-catalog.mts.');
} else writeFileSync(path, output);
