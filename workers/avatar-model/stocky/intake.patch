+def stocky_tail(painted, guide, heading):
+    """Measure only rearward pixels in the hip band beyond the expected trunk."""
+    if heading not in ("se", "e", "ne", "nw", "w", "sw"):
+        return 0, 0
+    def widths(alpha):
+        mask = alpha > 96
+        height = len(mask)
+        abdomen = np.where(mask[round(height*.52):round(height*.74)])[1]
+        hips = np.where(mask[round(height*.74):])[1]
+        if not len(abdomen) or not len(hips):
+            return 0, 0
+        width = abdomen.max() - abdomen.min() + 1
+        overhang = abdomen.min()-hips.min() if heading in ("se","e","ne") else hips.max()-abdomen.max()
+        return max(0, int(overhang)), int(width)
+    actual, width = widths(painted)
+    expected, guide_width = widths(guide)
+    excess = max(0, actual - round(expected * width / max(1, guide_width)))
+    return (excess, 0) if heading in ("se","e","ne") else (0, excess)
 
 
