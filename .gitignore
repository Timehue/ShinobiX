scripts/vfx-sources/

# Playwright QA artifacts (screenshots, snapshots) generated during live testing
.playwright-mcp/
shinobij.client/playwright-report/
shinobij.client/test-results/
qa-*.jpeg
qa-*.png

# Disposable authenticated load-test credentials and local evidence
load-accounts*.json
presence-load-evidence*.json
disposable-concurrency*.json
concurrency-load-evidence*.json
/release-audit/evidence/

# ── Build output — NEVER commit ───────────────────────────────────────────
# Railway self-builds from source on every push to main (Dockerfile runs
# `npm run build`), and .dockerignore excludes both trees from the image
# context. cPanel — the only host that ever served a committed dist/ — was
# retired 2026-07-17, so these are served by no one. They were also ~728 MB of
# binary duplicated from public/ (the same pet .glb models committed twice),
# and every local rebuild churned them on line-endings alone.
dist/
shinobij.client/dist/
shinobij.client/scripts/.restyle-board-done.json
shinobij.client/scripts/.restyle-keyart-done.json
