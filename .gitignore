# ── Game-specific ─────────────────────────────────────────────────────────

# Save files (stored in S3 on AWS, local disk in dev — not source controlled)
shinobij.client/saves/

# Atomic write temp files and rolling backups
*.tmp
*.bak
*.corrupt-*.bak

# Local environment / secrets (OpenAI key etc.)
.env
shinobij.client/.env
**/appsettings.Development.json
**/appsettings.*.Development.json

# CI/CD deploy artifact
deploy.zip
publish/
/shinobij.client/saves/admin201.json.bak
/shinobij.client/saves/admin201.json

# Migration backups (contain player data — never commit)
upstash-backup-*.json
.vercel


# Local scratch / working dir (was the Phusion Passenger restart dir; cPanel retired)
tmp/

# Headless asset-generator review output (scripts/gen-asset.mjs) — eyeball
# locally, publish via /api/images, don't commit the raw generated WebPs.
shinobij.client/asset-gen-out/

# Generated pet-model work products stay local. Only the reviewed runtime roster
# and starter models below are published with the coliseum.
shinobij.client/public/pet-models/
!shinobij.client/public/pet-models/
shinobij.client/public/pet-models/*
!shinobij.client/public/pet-models/roster/
!shinobij.client/public/pet-models/roster/*.glb
# Stage-0 starters — the model every new player fights with before evolving.
!shinobij.client/public/pet-models/starter-earth.glb
!shinobij.client/public/pet-models/starter-fire.glb
!shinobij.client/public/pet-models/starter-lightning.glb
!shinobij.client/public/pet-models/starter-water.glb
!shinobij.client/public/pet-models/starter-wind.glb
!shinobij.client/public/pet-models/starter-earth-l.glb
!shinobij.client/public/pet-models/starter-earth-r.glb
!shinobij.client/public/pet-models/starter-fire-l.glb
!shinobij.client/public/pet-models/starter-fire-r.glb
!shinobij.client/public/pet-models/starter-lightning-l.glb
!shinobij.client/public/pet-models/starter-lightning-r.glb
!shinobij.client/public/pet-models/starter-water-l.glb
!shinobij.client/public/pet-models/starter-water-r.glb
!shinobij.client/public/pet-models/starter-wind-l.glb
!shinobij.client/public/pet-models/starter-wind-r.glb
# Hollow Warfront runtime prop/boss GLBs — loaded at /pet-models/*.glb by the 3D
# stage; MUST be published or the Warfront 404s them (SPA index.html) and crashes.
!shinobij.client/public/pet-models/gate-warden.glb
!shinobij.client/public/pet-models/gate-warden-rigged.glb
!shinobij.client/public/pet-models/ward-totem.glb
!shinobij.client/public/pet-models/wf-boulder.glb
!shinobij.client/public/pet-models/wf-lantern.glb
!shinobij.client/public/pet-models/ember-wolf-rigged.gltf
!shinobij.client/public/pet-models/roster-manifest.json
!shinobij.client/public/pet-models/THIRD_PARTY_ASSETS.md

# Composite badge sources — re-export from AI tool if needed; sliced output in shinobij.client/public/badges/ is committed
scripts/badge-sources/

# Battle-VFX source frames (CodeManu "Free VFX Asset Pack") — re-extract on a dev
